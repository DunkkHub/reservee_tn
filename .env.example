# Reservee TN environment template
# Copy the relevant section to .env.local for local development or to your
# hosting provider's environment variable UI for production.
# Never commit .env.local or real production secrets.

############################
# Local development (XAMPP)
############################

NODE_ENV=development

APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace_with_secure_random_secret

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=reservee_tn
DATABASE_URL=mysql://root:@127.0.0.1:3306/reservee_tn
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_SSL_CA=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_locally
ADMIN_NAME=Reservee Admin
ADMIN_PHONE=+21600000000

VERIFICATION_CODE_DEV_PREVIEW=true
BOOKING_OTP_DEV_PREVIEW=true

############################
# Production (Vercel + Aiven MySQL)
############################

# NODE_ENV is set by Vercel.
# APP_URL=https://reserveetn.app
# NEXT_PUBLIC_APP_URL=https://reserveetn.app
# BETTER_AUTH_URL=https://reserveetn.app
# BETTER_AUTH_SECRET=replace_with_new_secure_production_secret
#
# DB_HOST=your-aiven-mysql-host
# DB_PORT=your-aiven-mysql-port
# DB_USER=your-aiven-mysql-user
# DB_PASSWORD=your-aiven-mysql-password
# DB_NAME=your-aiven-mysql-database
# DATABASE_URL=mysql://your-aiven-mysql-user:your-aiven-mysql-password@your-aiven-mysql-host:your-aiven-mysql-port/your-aiven-mysql-database
# DB_CONNECTION_LIMIT=5
# DB_SSL=true
# DB_SSL_CA=
#
# ADMIN_EMAIL=your-admin-email
# ADMIN_PASSWORD=your-strong-admin-password
# ADMIN_NAME=Reservee Admin
# ADMIN_PHONE=+21600000000

############################
# Notifications
############################

NOTIFICATION_EMAIL_PROVIDER=console
NOTIFICATION_SMS_PROVIDER=console
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_PHONE=

############################
# Media storage
############################

MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_UPLOAD_DIR=public/uploads
MEDIA_PUBLIC_BASE_PATH=/uploads
MEDIA_UPLOAD_MAX_BYTES=5000000

# Optional future media storage only. Do not use Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

############################
# Optional deterministic local seed credentials
############################

SEED_ADMIN_PASSWORD=
SEED_OWNER_PASSWORD=
SEED_CUSTOMER_PASSWORD=
