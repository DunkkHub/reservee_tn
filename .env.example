NODE_ENV=development

# App URLs
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth
# Production must use HTTPS, for example:
# BETTER_AUTH_URL=https://your-real-domain.com
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace_with_a_secure_random_secret

# Database
DATABASE_URL=mysql://user:password@localhost:3306/reservee_tn
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=reservee_tn

# Legacy signing used by older local helpers; keep strong in production
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_COOKIE_NAME=reservee_session
SESSION_TTL_HOURS=168

# Development-only verification previews
VERIFICATION_CODE_DEV_PREVIEW=true
BOOKING_OTP_DEV_PREVIEW=true

# Notifications
NOTIFICATION_EMAIL_PROVIDER=console
NOTIFICATION_SMS_PROVIDER=console
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_PHONE=

# Media storage
MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_UPLOAD_DIR=public/uploads
MEDIA_PUBLIC_BASE_PATH=/uploads
MEDIA_UPLOAD_MAX_BYTES=5000000

# Optional deterministic local seed credentials
SEED_ADMIN_PASSWORD=
SEED_OWNER_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# Optional first-admin creation
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_locally
ADMIN_NAME=Reservee Admin
ADMIN_PHONE=
